<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/edge_oneauth_legacy_LinearLayout1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/edge_oneauth_legacy_http_auth_dialog_padding_left"
    android:paddingRight="@dimen/edge_oneauth_legacy_http_auth_dialog_padding_right" >

    <TextView
        android:id="@+id/edge_oneauth_legacy_httpAuthOriginText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/edge_oneauth_legacy_http_auth_dialog_padding_top"
        android:text=""
        android:visibility="gone"
        tools:visibility="visible" />

    <EditText
        android:inputType="text"
        android:id="@+id/edge_oneauth_legacy_editUserName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="@string/edge_oneauth_legacy_http_auth_dialog_username"
        android:paddingTop="@dimen/edge_oneauth_legacy_http_auth_dialog_padding_top" >

        <requestFocus />
    </EditText>

    <EditText
        android:id="@+id/edge_oneauth_legacy_editPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="@string/edge_oneauth_legacy_http_auth_dialog_password"
        android:inputType="textPassword"
        android:paddingTop="@dimen/edge_oneauth_legacy_http_auth_dialog_padding_top"
        android:paddingBottom="@dimen/edge_oneauth_legacy_http_auth_dialog_padding_bottom" />

</LinearLayout>